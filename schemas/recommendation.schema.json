{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recommendation.schema.json",
  "title": "Recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["continue", "similar"],
  "properties": {
    "continue": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "similar": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "title": "RecommendationEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["book_id", "reason", "source_ids"],
      "properties": {
        "book_id": { "$ref": "common.schema.json#/$defs/book_id" },
        "reason": { "type": "string" },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/source_id" }
        }
      }
    }
  }
}

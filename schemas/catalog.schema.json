{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "catalog.schema.json",
  "title": "Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["books", "sources", "updated_at"],
  "properties": {
    "books": { "type": "array", "items": { "$ref": "book.schema.json" } },
    "sources": { "type": "array", "items": { "$ref": "source.schema.json" } },
    "updated_at": { "$ref": "common.schema.json#/$defs/iso_date" }
  }
}

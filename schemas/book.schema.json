{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "book.schema.json",
  "title": "Book",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "book_id", "series_id", "title", "aliases", "volume", "edition", "publisher",
    "release_date_precision", "sale_status", "sources"
  ],
  "properties": {
    "book_id": { "$ref": "common.schema.json#/$defs/book_id" },
    "series_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "volume": { "type": "number" },
    "edition": { "$ref": "common.schema.json#/$defs/edition" },
    "publisher": { "type": "string" },
    "release_date": { "type": "string", "format": "date" },
    "release_date_precision": { "enum": ["day", "month"] },
    "sale_status": { "enum": ["announced", "preorder", "released"] },
    "sources": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/source_id" }
    },
    "store_url": { "type": "string", "format": "uri" },
    "cover_url": { "type": "string", "format": "uri" }
  }
}

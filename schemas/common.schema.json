{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "$defs": {
    "edition": {
      "title": "Edition",
      "type": "string",
      "enum": ["manga", "light_novel", "special_set", "big_book"]
    },
    "match_status": {
      "title": "MatchStatus",
      "enum": ["duplicate_merged", "distinct_edition", "needs_review"]
    },
    "book_id": { "title": "BookId", "type": "string", "minLength": 1 },
    "source_id": { "title": "SourceId", "type": "string", "minLength": 1 },
    "iso_date": { "title": "IsoDate", "type": "string", "format": "date-time" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "extraction.schema.json",
  "title": "Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "title": "ExtractedItem",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "publisher",
          "volume",
          "edition",
          "edition_evidence",
          "edition_confidence",
          "release_date",
          "release_date_precision",
          "sale_status"
        ],
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume": {
            "type": [
              "number",
              "string",
              "null"
            ],
            "description": "A single stated volume, including decimal volumes. Preserve Thai digits and prefixes for code normalization."
          },
          "edition": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/edition"
              },
              {
                "type": "null"
              }
            ]
          },
          "edition_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "edition_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD for an explicit day; null for month-only or absent dates. Never invent a day."
          },
          "release_date_precision": {
            "type": ["string", "null"],
            "enum": [
              "day",
              "month",
              "unknown",
              null
            ]
          },
          "sale_status": {
            "type": ["string", "null"],
            "enum": [
              "announced",
              "preorder",
              "released",
              null
            ]
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "match_result.schema.json",
  "title": "MatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_book_id", "same_series", "same_volume", "edition",
    "edition_confidence", "matched_alias", "reason"
  ],
  "properties": {
    "candidate_book_id": { "type": ["string", "null"] },
    "same_series": { "type": "boolean" },
    "same_volume": { "type": "boolean" },
    "edition": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/edition" },
        { "type": "null" }
      ]
    },
    "edition_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "matched_alias": { "type": ["string", "null"] },
    "reason": { "type": "string" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review_queue.schema.json",
  "title": "ReviewQueue",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "source_id", "extracted", "candidates", "reason", "status", "created_at"],
        "properties": {
          "review_id": { "type": "string", "minLength": 1 },
          "source_id": { "$ref": "common.schema.json#/$defs/source_id" },
          "extracted": { "type": "object", "additionalProperties": true },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["book_id", "edition", "confidence"],
              "properties": {
                "book_id": { "$ref": "common.schema.json#/$defs/book_id" },
                "edition": { "$ref": "common.schema.json#/$defs/edition" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "reason": { "type": "string" },
          "status": { "enum": ["open", "resolved"] },
          "created_at": { "$ref": "common.schema.json#/$defs/iso_date" }
        }
      }
    }
  }
}

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EXTRACT_MODEL=

# Required for production chat. Local development uses an in-memory limit by default.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_AI_ENABLED=true

# Shared Supabase demo shelf. Set SHELFPILOT_DATA_BACKEND=supabase to enable.
SHELFPILOT_DATA_BACKEND=
SHELFPILOT_SUPABASE_URL=
SHELFPILOT_SUPABASE_PUBLISHABLE_KEY=
SHELFPILOT_SUPABASE_DEMO_EMAIL=
SHELFPILOT_SUPABASE_DEMO_PASSWORD=

# Required for hosted Supabase mode. Use a separate random team password.
SHELFPILOT_TEAM_PASSWORD=

# Optional for a Vercel Preview branch shared with judges through a Shareable Link.
SHELFPILOT_PREVIEW_JUDGE_ACCESS=
